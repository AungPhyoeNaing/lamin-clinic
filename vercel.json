{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "rewrites":  [
                     {
                         "destination":  "https://hzmzzploocfkccndrvqi.supabase.co/auth/v1/:path*",
                         "source":  "/clinic-api/auth/v1/:path*"
                     },
                     {
                         "destination":  "https://hzmzzploocfkccndrvqi.supabase.co/rest/v1/:path*",
                         "source":  "/clinic-api/rest/v1/:path*"
                     },
                     {
                         "destination":  "https://hzmzzploocfkccndrvqi.supabase.co/storage/v1/:path*",
                         "source":  "/clinic-api/storage/v1/:path*"
                     },
                     {
                         "destination":  "/index.html",
                         "source":  "/(.*)"
                     }
                 ],
    "headers":  [
                    {
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store"
                                        },
                                        {
                                            "key":  "CDN-Cache-Control",
                                            "value":  "no-store"
                                        },
                                        {
                                            "key":  "Vercel-CDN-Cache-Control",
                                            "value":  "no-store"
                                        },
                                        {
                                            "key":  "x-vercel-enable-rewrite-caching",
                                            "value":  "0"
                                        }
                                    ],
                        "source":  "/clinic-api/:path((?!storage/v1/object/public/article-media/).*)"
                    },
                    {
                        "source": "/clinic-api/storage/v1/object/public/article-media/:path*",
                        "headers": [
                            { "key": "Cache-Control", "value": "public, max-age=3600" },
                            { "key": "CDN-Cache-Control", "value": "no-store" },
                            { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
                            { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
                        ]
                    },
                    {
                        "source": "/assets/:path*",
                        "headers": [
                            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
                        ]
                    }
                ]
}
